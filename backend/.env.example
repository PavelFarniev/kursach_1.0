DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/killexam
JWT_SECRET_KEY=replace-with-long-random-secret
ACCESS_COOKIE_NAME=killexam_access_token
REFRESH_COOKIE_NAME=killexam_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# GigaChat authorization key from https://developers.sber.ru/
GIGACHAT_CREDENTIALS=
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_TIMEOUT=30

AUDIT_LOG_PATH=./runtime_logs/audit.log
AUDIT_LOG_MAX_BYTES=2000000
AUDIT_LOG_BACKUP_COUNT=5
RESPONSE_TIME_WARNING_MS=750
